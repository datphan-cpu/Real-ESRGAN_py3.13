# ==============================================================================
# Model weights and Large Binary Checkpoints
# Exclude heavy model weight files (*.pth, *.pt, *.onnx, *.bin, etc.) across
# the repository (including weights/, gfpgan/weights/, facexlib/weights/)
# while retaining folder placeholder / documentation files.
# ==============================================================================
*.pth
*.pt
*.ckpt
*.onnx
*.bin
*.tflite
*.pb
*.pkl

# Project weights folder
weights/*
!weights/README.md
!weights/**/README.md
!weights/**/.gitkeep

# ==============================================================================
# Runtime Outputs, Experiments, Logs, and Temp Files
# ==============================================================================
results/*
!results/.gitkeep
experiments/*
!experiments/.gitkeep
tb_logger/*
wandb/*
tmp/*
temp/*
*.log

# ==============================================================================
# Python Byte-compiled / Optimized / C Extensions
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.dll
*.dylib

# ==============================================================================
# Distribution / Packaging / Builds
# ==============================================================================
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ==============================================================================
# Virtual Environments
# ==============================================================================
.env
.venv
.venv*/
env/
venv/
ENV/
env.bak/
venv.bak/

# ==============================================================================
# IDEs and Editors
# ==============================================================================
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# Unit test / Coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
